# Optional. The app runs locally on fixtures with every variable unset.

# Canonical origin of this deployment, used for metadata URLs.
NEXT_PUBLIC_SITE_URL=

# Google Maps. When set, map sections use the interactive embed for records
# that carry coordinates or an address. Without it, a styled location card
# with a directions link is rendered instead. Client-safe by design.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Future ingestion adapter. When set, POST /api/poc accepts new records
# guarded by an Authorization: Bearer <token> header. Leave unset to disable.
POC_INGESTION_TOKEN=

# Future database adapter (PostgreSQL or compatible). Leave unset to use
# the local fixture repository.
DATABASE_URL=

# Future R2 media adapter for generated placeholder assets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
