# Optional. The app runs locally on fixtures with every variable unset.

# ---------------------------------------------------------------- Authentication
# HMAC secret for operator session cookies. Required in production (>= 32 chars).
# Generate: openssl rand -base64 48
AUTH_SECRET=
# Allowlisted operator emails (comma-separated). Unset defaults to a
# development-only operator address.
ADMIN_EMAILS=
# Google OAuth (optional production login method). When set, "Continue with
# Google" appears on /login and only ADMIN_EMAILS accounts may sign in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Static operator password (alternative to OAuth). Compared in constant
# time; pair with ADMIN_EMAILS.
OPERATOR_PASSWORD=

# ---------------------------------------------------------------- Share links
# Absolute base URL used when generating customer share links
# (for example https://poc.example.com). Falls back to the request origin.
SHARE_LINK_BASE_URL=

# ---------------------------------------------------------------- POC rendering
# Canonical origin of this deployment, used for metadata URLs.
NEXT_PUBLIC_SITE_URL=
# Google Maps. When set, map sections use the interactive embed for records
# that carry coordinates or an address. Without it, a styled location card
# with a directions link is rendered instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Extra image hosts allowed in POC records beyond the defaults
# (picsum.photos placeholders). Comma-separated hostnames.
POC_IMAGE_HOST_ALLOWLIST=

# ---------------------------------------------------------------- Database
# PostgreSQL. Required in production: customer records, share links, and the
# automation bridge all live here (Drizzle migrations: npm run db:migrate).
# Without it in production, customer routes and the automation surface fail
# closed; local development falls back to fixtures and a JSON share store.
DATABASE_URL=
# Scratch database for integration tests and the smoke command. Honored ONLY
# when NODE_ENV=test (never in production); takes precedence over DATABASE_URL.
TEST_DATABASE_URL=

# ------------------------------------------------- POC record repository mode
# auto (default): production uses PostgreSQL when DATABASE_URL is set (and
# fails closed without it); development/test use the fixture repository.
# postgres: force the persistent repository (requires DATABASE_URL).
# fixtures: force fixtures (refused in production — synthetic businesses
# must never render for customers).
POC_REPOSITORY_MODE=

# ---------------------------------------------------------------- Automation bridge
# Master switch for mutating automation operations (default: enabled).
AUTOMATION_ENABLED=
# Halts publication and sending IMMEDIATELY when "true" (checked right
# before the share link is created and right before the provider call).
AUTOMATION_EMERGENCY_STOP=
# Maximum leads ingested per UTC day (default 100).
AUTOMATION_DAILY_LEAD_LIMIT=
# Minimum qualification score (0-100) for an ingested candidate to enter
# the pipeline (default 40). Weaker candidates are rejected outright.
AUTOMATION_MIN_LEAD_SCORE=

# ---------------------------------------------------------------- Outreach
# Live sending is DISABLED by default. When "true", send_outreach uses the
# configured email provider. Provider selection is exhaustive: "mock"
# (development/test only — fails closed in production with sending enabled)
# or "emailjs" (the implemented live provider; see
# docs/emailjs-template-setup.md). Anything else fails configuration.
OUTREACH_SEND_ENABLED=
OUTREACH_EMAIL_PROVIDER=
# Bounded provider call time (1000-60000 ms; default 10000). A timeout
# resolves as delivery_unknown (never auto-retried).
OUTREACH_PROVIDER_TIMEOUT_MS=
# Maximum send attempts per UTC day (default 50).
OUTREACH_DAILY_SEND_LIMIT=
# Maximum send attempts per email domain per day (default 2).
OUTREACH_PER_DOMAIN_DAILY_LIMIT=
# Follow-ups per lead after the initial message (default 2, hard cap 2).
OUTREACH_MAX_FOLLOWUPS=
# Compliance identity (all required together when sending is enabled).
OUTREACH_SENDER_NAME=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
# Physical postal address included in every message footer (required when
# sending is enabled).
OUTREACH_POSTAL_ADDRESS=
# Prepend "This is an advertisement." to the footer when "true".
OUTREACH_ADVERTISEMENT_DISCLOSURE=

# --------------------------------------------------------------- EmailJS
# The live email provider (@emailjs/nodejs, server-side only). All four
# values are required when OUTREACH_SEND_ENABLED=true with provider=emailjs;
# EMAILJS_PRIVATE_KEY is required in production. See
# docs/emailjs-template-setup.md for the one-time dashboard setup.
EMAILJS_SERVICE_ID=service_dhodx9y
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Dry run defaults to TRUE outside production: the provider never contacts
# EmailJS at all (deterministic local outcome). Production defaults to
# false but still needs OUTREACH_SEND_ENABLED=true to ever send.
EMAILJS_DRY_RUN=
EMAILJS_REQUEST_TIMEOUT_MS=

# ------------------------------------------------------- Contact encryption
# Versioned AES-256-GCM keys for raw contact addresses, as
# "<keyId>:<base64 32-byte key>" entries, comma-separated.
# Generate one with: openssl rand -base64 32
# Rotation: append the new key, flip CONTACT_DATA_ACTIVE_KEY_ID, keep old
# keys configured until no envelope references them. Keys never live in the
# database or the repository. The dedup/suppression hash derives (HKDF) from
# the lexicographically-FIRST key id, so hashes stay stable across rotation.
CONTACT_DATA_ENCRYPTION_KEYS=
CONTACT_DATA_ACTIVE_KEY_ID=

# ---------------------------------------------------------------- Remote MCP
# Public base URL of this deployment as announced to MCP clients
# (for example https://poc.example.com).
MCP_PUBLIC_BASE_URL=
# OAuth 2.1 resource-server validation. ALL four values are required in
# production for the MCP endpoint to accept any token; otherwise it stays
# fail-closed (503) until an authorization server is registered.
# MCP_EXPECTED_ISSUER: your authorization server (e.g. https://auth.example.com)
# MCP_JWKS_URL: the issuer's JWKS endpoint (operator-configured; the server
# never fetches caller-supplied URLs).
MCP_EXPECTED_ISSUER=
MCP_EXPECTED_AUDIENCE=
MCP_JWKS_URL=
# Space-separated scopes required/recognized (default: all five).
MCP_REQUIRED_SCOPES=
# Development-only static bearer for the MCP + internal HTTP surface.
# Structurally impossible to enable in production (enforced twice).
ALLOW_DEV_MCP_BEARER=
# Generate: openssl rand -base64 32
DEV_MCP_BEARER_TOKEN=

# ---------------------------------------------------------------- Docker deploy
# docker-compose.yml loads your real values from a local .env file (never
# committed, never baked into the image) and injects DATABASE_URL itself.
# Minimum production set in that file:
#   AUTH_SECRET=<openssl rand -base64 48>
#   ADMIN_EMAILS=you@example.com
#   OPERATOR_PASSWORD=<or Google OAuth: AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET>
#   CONTACT_DATA_ENCRYPTION_KEYS=<id>:<openssl rand -base64 32>
#   CONTACT_DATA_ACTIVE_KEY_ID=<id>
#   OUTREACH_SENDER_NAME/FROM_EMAIL/REPLY_TO/POSTAL_ADDRESS
#   EMAILJS_* (see docs/emailjs-template-setup.md)
#   MCP_PUBLIC_BASE_URL + MCP_* OAuth set when connecting the scheduler
# Safe defaults on deploy: OUTREACH_SEND_ENABLED=false, EMAILJS_DRY_RUN=true.
# The database credentials (POSTGRES_USER/PASSWORD/DB) also live in .env for
# compose; migrations apply automatically on container start.
