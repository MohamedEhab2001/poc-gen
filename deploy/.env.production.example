# Store the completed file as the GitHub Actions secret PRODUCTION_ENV_FILE.
# Never commit the real values.

# Operator authentication
AUTH_SECRET=generate-with-openssl-rand-base64-48
ADMIN_EMAILS=you@example.com
OPERATOR_PASSWORD=use-a-long-random-password

# Public deployment
NEXT_PUBLIC_SITE_URL=https://pocgen.daimooma.com
SHARE_LINK_BASE_URL=https://pocgen.daimooma.com
MCP_PUBLIC_BASE_URL=https://pocgen.daimooma.com
POC_REPOSITORY_MODE=postgres

# PostgreSQL container managed by deploy/docker-compose.postgres.yml.
# URL-encode special characters in POSTGRES_PASSWORD before putting the same
# password inside DATABASE_URL.
POSTGRES_DB=pocgen
POSTGRES_USER=pocgen
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST_PORT=54329
DATABASE_URL=postgresql://pocgen:URL_ENCODED_PASSWORD@127.0.0.1:54329/pocgen

# Automation safety switches
AUTOMATION_ENABLED=true
AUTOMATION_EMERGENCY_STOP=false
AUTOMATION_DAILY_LEAD_LIMIT=20
AUTOMATION_MIN_LEAD_SCORE=60

# Start production deployment in dry-run/no-send mode. Enable live sending
# only after the deployed POC and unsubscribe links have been verified.
OUTREACH_SEND_ENABLED=false
OUTREACH_EMAIL_PROVIDER=emailjs
OUTREACH_DAILY_SEND_LIMIT=5
# Must be at least the campaign's per-run send cap so shared public mailbox
# providers (gmail.com, outlook.com, yahoo.com) do not block distinct leads.
OUTREACH_PER_DOMAIN_DAILY_LIMIT=3
OUTREACH_MAX_FOLLOWUPS=1
OUTREACH_SENDER_NAME=Mohamed Ehab
OUTREACH_SENDER_INTRO=I'm Mohamed Ehab, a senior software engineer and product builder. I help small businesses create clear, professional websites that make it easier for customers to find and contact them.
OUTREACH_SENDER_LINKEDIN_URL=https://www.linkedin.com/in/your-profile-slug
OUTREACH_FROM_EMAIL=you@example.com
OUTREACH_REPLY_TO=you@example.com
OUTREACH_POSTAL_ADDRESS=replace-with-valid-postal-address
OUTREACH_ADVERTISEMENT_DISCLOSURE=true

EMAILJS_SERVICE_ID=service_dhodx9y
EMAILJS_TEMPLATE_ID=replace-me
EMAILJS_PUBLIC_KEY=replace-me
EMAILJS_PRIVATE_KEY=replace-me
EMAILJS_DRY_RUN=true
EMAILJS_REQUEST_TIMEOUT_MS=10000

# Generate: openssl rand -base64 32
CONTACT_DATA_ENCRYPTION_KEYS=v1:replace-with-base64-32-byte-key
CONTACT_DATA_ACTIVE_KEY_ID=v1

# Production MCP remains fail-closed until a real OAuth issuer is configured.
MCP_EXPECTED_ISSUER=
MCP_EXPECTED_AUDIENCE=
MCP_JWKS_URL=
MCP_REQUIRED_SCOPES=poc:read poc:write outreach:prepare outreach:send reports:read
